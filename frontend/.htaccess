# Dr. Farah frontend — static hosting rules (Apache).
Options -Indexes

ErrorDocument 404 /404.html

# Staging is an active review environment. Avoid stale frontend responses while
# visual QA is in progress. Production cache policy can be tightened separately.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|css|js|txt)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve the byte-safe v5 runtime for the existing app.js URL. Keeping the
  # public URL stable avoids editing every static template, while replacing the
  # fragile runtime that swapped critical images to unreliable binary assets.
  RewriteRule ^app\.js$ app-v5.js [L]

  # Do not rewrite legacy image URLs. The original HTML image remains visible
  # until app-v5 has reconstructed and successfully decoded the approved image.

  # If request maps to an existing file or directory, serve it as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, if "<name>.html" exists, serve it for the extensionless URL.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Do not serve the raw .htaccess or dotfiles.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
