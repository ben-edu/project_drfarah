# Dr. Farah production frontend — Apache rules.
Options -Indexes

ErrorDocument 404 /404.html

# LEGACY_REDIRECT_RISK_ACCEPTED: 2026-09-21.
# The operator explicitly approved launching with the confirmed high-value
# redirects below while the complete historical WordPress URL inventory is
# finished after launch. GoDaddy hosting is retained as the recovery source;
# it must not be deleted during the stabilization window.

<IfModule mod_headers.c>
  # Unversioned HTML/CSS/JS should revalidate; images and fonts may be cached.
  <FilesMatch "\.(?:html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:svg|webp|jpg|jpeg|png|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: HTTPS + apex. HAProxy terminates TLS and supplies
  # X-Forwarded-Proto.
  RewriteCond %{HTTP_HOST} ^www\.drfarahvipurgentcare\.com$ [NC]
  RewriteRule ^ https://drfarahvipurgentcare.com%{REQUEST_URI} [R=301,L]

  # Clear legacy page and trailing-slash aliases.
  RewriteRule ^booking/?$ https://drfarahvipurgentcare.com/book [R=301,L,NC]
  RewriteRule ^services/$ https://drfarahvipurgentcare.com/services [R=301,L,NC]

  # Confirmed legacy WordPress structural redirects.
  RewriteRule ^about-us/?$ https://drfarahvipurgentcare.com/about [R=301,L,NC]
  RewriteRule ^contact-us/?$ https://drfarahvipurgentcare.com/contact [R=301,L,NC]
  RewriteRule ^prp-prf-exosomes-center/?$ https://drfarahvipurgentcare.com/prp-treatments [R=301,L,NC]
  RewriteRule ^urgent-care-near-you/?$ https://drfarahvipurgentcare.com/services [R=301,L,NC]
  RewriteRule ^vip-urgent-care/?$ https://drfarahvipurgentcare.com/services [R=301,L,NC]
  RewriteRule ^faq/?$ https://drfarahvipurgentcare.com/services [R=301,L,NC]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
